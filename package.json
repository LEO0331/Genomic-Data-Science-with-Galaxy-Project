{
  "name": "genomic-galaxy-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:ci": "next start --hostname 127.0.0.1 --port 3000",
    "test:frontend": "vitest run --config vitest.frontend.config.ts",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "coverage:frontend": "vitest run --config vitest.frontend.config.ts --coverage",
    "coverage:backend": "vitest run --config vitest.backend.config.ts --coverage",
    "coverage": "npm run coverage:frontend && npm run coverage:backend",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components data lib tests *.config.mjs *.config.ts"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.14.11",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "10.4.20",
    "eslint": "9.38.0",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.0.2",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
